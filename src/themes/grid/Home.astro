---
import Subscribe from '../../components/Subscribe.astro';
import EpisodeGrid from './EpisodeGrid.astro';
import { getPodcast } from '../../lib/feed';
import { archiveHref } from '../../lib/archive';

const { show, episodes } = await getPodcast();
// Eight fills even rows at 2 and 4 columns.
const latest = episodes.slice(0, 8);
---

<section class="hero">
  {show.image && <img class="hero-art" src={show.image} alt={`${show.title} cover art`} width="240" height="240" />}
  <h1>{show.title}</h1>
  {show.author && <p class="author">{show.author}</p>}
  <p class="description">{show.summary}</p>
  <Subscribe />
</section>

<section>
  <div class="section-title">
    <h2>Latest episodes</h2>
    {episodes.length > latest.length && <a href={archiveHref(1)}>All {episodes.length} episodes</a>}
  </div>
  <EpisodeGrid episodes={latest} />
</section>

<style>
  .hero { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 3.5rem; }
  .hero-art { width: 240px; aspect-ratio: 1; border-radius: var(--radius); object-fit: cover; box-shadow: var(--shadow); margin-bottom: 1.5rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.2rem); }
  .author { color: var(--muted); margin: 0 0 0.75rem; }
  .description { max-width: 40rem; margin: 0 0 1.5rem; }
  .hero :global(.subscribe) { justify-content: center; }

  /* Grid needs a wider page than the reading layouts. */
  :global(html[data-layout="grid"]) { --width: 68rem; }
</style>
