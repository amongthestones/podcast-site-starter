---
import EpisodeMeta from '../../components/EpisodeMeta.astro';
import EpisodeNav from '../../components/EpisodeNav.astro';
import Player from '../../components/Player.astro';
import Subscribe from '../../components/Subscribe.astro';
import type { Episode } from '../../lib/feed';

interface Props {
  episode: Episode;
  newer?: Episode;
  older?: Episode;
}

const { episode, newer, older } = Astro.props;
---

<article>
  <header>
    {episode.image && <img src={episode.image} alt="" width="140" height="140" />}
    <div>
      <EpisodeMeta episode={episode} showExplicit />
      <h1>{episode.title}</h1>
    </div>
  </header>

  <Player episode={episode} />
  <div class="show-notes" set:html={episode.contentHtml} />
  <Subscribe />
  <EpisodeNav newer={newer} older={older} />
</article>

<style>
  header { display: grid; gap: 1.25rem; margin-bottom: 1.75rem; }
  @media (min-width: 640px) {
    header { grid-template-columns: 140px 1fr; align-items: center; }
  }
  img { width: 140px; aspect-ratio: 1; border-radius: var(--radius); object-fit: cover; }
  h1 { font-size: clamp(1.7rem, 4.5vw, 2.3rem); }
</style>
