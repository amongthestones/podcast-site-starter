---
import Subscribe from '../../components/Subscribe.astro';
import EpisodeRows from './EpisodeRows.astro';
import { getPodcast } from '../../lib/feed';
import { archiveHref } from '../../lib/archive';

const { show, episodes } = await getPodcast();
const latest = episodes.slice(0, 10);
---

<section class="intro">
  <h1>{show.title}</h1>
  <p>{show.summary}</p>
  <Subscribe />
</section>

<EpisodeRows episodes={latest} />

{episodes.length > latest.length && <p class="more"><a href={archiveHref(1)}>All {episodes.length} episodes</a></p>}

<style>
  .intro { margin-bottom: 3rem; }
  h1 { font-size: clamp(1.8rem, 4.5vw, 2.3rem); }
  .intro p { color: var(--muted); margin: 0 0 1rem; }
  .more { margin-top: 1.5rem; }
</style>

<style is:global>
  /* Minimal drops images and button chrome everywhere it's active. */
  html[data-layout="minimal"] .brand img { display: none; }
  html[data-layout="minimal"] .subscribe { gap: 0.25rem 1rem; }
  html[data-layout="minimal"] .subscribe a { padding: 0; border: 0; background: none; color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  html[data-layout="minimal"] { --width: 40rem; }
</style>
