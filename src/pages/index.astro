---
import Base from '../layouts/Base.astro';
import Setup from '../components/Setup.astro';
import { getPodcast } from '../lib/feed';
import { seriesSchema } from '../lib/schema';
import { config } from '../site.config';
import { getTheme } from '../themes/registry';

const podcast = config.feedUrl ? await getPodcast() : undefined;
const { Home } = getTheme().layout;
---

{
  podcast ? (
    <Base schema={seriesSchema(podcast.show, Astro.site)}>
      <Home />
    </Base>
  ) : (
    <Setup />
  )
}
