---
import Base from '../../layouts/Base.astro';
import { getPodcast } from '../../lib/feed';
import type { Episode } from '../../lib/feed';
import { episodeSchema } from '../../lib/schema';
import { config } from '../../site.config';
import { getTheme } from '../../themes/registry';

export async function getStaticPaths() {
  if (!config.feedUrl) return [];
  const { episodes } = await getPodcast();
  return episodes.map((episode, i) => ({
    params: { section: config.episodePath, slug: episode.slug },
    props: { episode, newer: episodes[i - 1], older: episodes[i + 1] },
  }));
}

interface Props {
  episode: Episode;
  newer?: Episode;
  older?: Episode;
}

const { episode, newer, older } = Astro.props;
const { show } = await getPodcast();
const { Episode: EpisodePage } = getTheme().layout;
---

<Base
  title={episode.title}
  description={episode.summary}
  image={episode.image}
  type="article"
  schema={episodeSchema(episode, show, Astro.site)}
>
  <EpisodePage episode={episode} newer={newer} older={older} />
</Base>
