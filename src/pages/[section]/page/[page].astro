---
import Base from '../../../layouts/Base.astro';
import { getArchivePage } from '../../../lib/archive';
import { getPodcast } from '../../../lib/feed';
import { config } from '../../../site.config';
import { getTheme } from '../../../themes/registry';

export async function getStaticPaths() {
  if (!config.feedUrl) return [];
  const { episodes } = await getPodcast();
  const totalPages = Math.ceil(episodes.length / config.episodesPerPage);
  // Page 1 lives at /episodes/, so start at 2.
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { section: config.episodePath, page: String(i + 2) },
  }));
}

const page = Number(Astro.params.page);
const { show } = await getPodcast();
const archive = await getArchivePage(page);
const { Archive } = getTheme().layout;
---

<Base title={`Episodes, page ${page}`} description={`All episodes of ${show.title}.`}>
  <Archive {...archive} />
</Base>
