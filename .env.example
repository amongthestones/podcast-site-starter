# Local testing only. Settings normally live in podcast.config.json.
# Anything set here, or in your host's environment variables, overrides that file.

PODCAST_FEED_URL=https://feeds.castos.com/xxxxx

# Your site's public address, for canonical links and the sitemap. Netlify and
# Vercel fill this in automatically. Set it on Cloudflare.
SITE_URL=

# Overrides for podcast.config.json settings.
EPISODE_PATH=
SLUG_SOURCE=
SUBSCRIBE_AUTO=
SUBSCRIBE_LINKS=

# Only for the optional Netlify scheduled function.
BUILD_HOOK_URL=
