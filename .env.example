# Required. Your podcast's public RSS feed.
PODCAST_FEED_URL=https://feeds.castos.com/xxxxx

# Your site's public address. Used for canonical links, sitemap, and rebuild checks.
SITE_URL=https://example.com

# Optional. Folder episodes live under: example.com/episodes/my-episode/
# The default matches Castos-hosted websites. Moving from WordPress with
# Seriously Simple Podcasting? Use "podcast" so old links keep working.
EPISODE_PATH=episodes

# Optional. "link" (default) uses the slug from each episode's link in the feed,
# falling back to the title. "title" always builds the slug from the title.
SLUG_SOURCE=link

# Optional subscribe buttons. RSS is always shown.
APPLE_PODCASTS_URL=
SPOTIFY_URL=
YOUTUBE_URL=

# Automatic rebuilds only. Paste the build or deploy hook from your host.
BUILD_HOOK_URL=
