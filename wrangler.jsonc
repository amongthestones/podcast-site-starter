// Cloudflare Workers config, used by the "Deploy to Cloudflare" button.
// The site is static files only, so there is no Worker script.
{
  "name": "podcast-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Sends /episodes/my-episode to /episodes/my-episode/, so links from
    // Castos-hosted websites (no trailing slash) keep working.
    "html_handling": "auto-trailing-slash"
  }
}
